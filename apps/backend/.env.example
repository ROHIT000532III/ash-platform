# The active provider. Currently supported: ollama, demo.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Request timeout and number of additional retry attempts.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_REQUEST_RETRIES=1

# Number of saved messages included in each model request. Stored messages are not deleted.
AI_CONTEXT_MESSAGE_LIMIT=30

# Optional controlled fallback when Ollama is offline. Leave empty to return a 503.
AI_FALLBACK_PROVIDER=

# Required for persistent session validation across backend restarts.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_DAYS=14

# Read-only File Explorer root. Paths from the browser are always relative to this directory.
ASH_WORKSPACE_ROOT=workspace
